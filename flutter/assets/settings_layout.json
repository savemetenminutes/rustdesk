{
  "categories": [
    {
      "id": "ui",
      "label": "UI",
      "icon": "palette",
      "items": [
        {"type": "widget", "widget": "theme"},
        {"type": "widget", "widget": "language"},
        {"type": "radio", "label": "Scrolling of a remote screen larger than its window",
         "tooltip": "scroll-style-tip",
         "options": [
           {"value": "scrollbar", "label": "Scrollbars"},
           {"value": "scrollauto", "label": "Follow the cursor (the view scrolls with the cursor position)"},
           {"value": "scrolledge", "label": "Scroll when the cursor reaches the window edge"}
         ],
         "default": {"kind": "default", "key": "scroll_style"},
         "peer": {"kind": "peer", "key": "scroll_style", "live": "scrollStyle"}},
        {"type": "number", "label": "Edge scrolling: width of the edge zone (px)",
         "default": {"kind": "default", "key": "edge-scroll-edge-thickness"},
         "peer": {"kind": "peer", "key": "edge_scroll_edge_thickness", "live": "edgeThickness"}},
        {"type": "bool", "label": "Open each remote screen in its own window",
         "tooltip": "individual-windows-tip",
         "default": {"kind": "default", "key": "displays_as_individual_windows"},
         "peer": {"kind": "peer", "key": "displays_as_individual_windows"}},
        {"type": "bool", "label": "Open file transfer, port forward, terminal and camera sessions as tabs",
         "tooltip": "open-in-tabs-tip",
         "default": {"kind": "local", "key": "enable-open-new-connections-in-tabs"}},
        {"type": "bool", "label": "Ask before closing a window with several tabs",
         "default": {"kind": "local", "key": "enable-confirm-closing-tabs"}},

        {"type": "section", "label": "Remote session toolbar"},
        {"type": "bool", "label": "Start sessions with the toolbar collapsed",
         "default": {"kind": "default", "key": "collapse_toolbar"},
         "peer": {"kind": "peer", "key": "collapse_toolbar", "toggle": "collapse_toolbar"}},
        {"type": "bool", "label": "Monitor switch button on the toolbar",
         "default": {"kind": "local", "key": "allow-monitor-switch-main-toolbar"},
         "offClears": [{"kind": "local", "key": "allow-monitor-switch-min-toolbar"}],
         "after": "reloadAllWindows"},
        {"type": "bool", "label": "Monitor switch button on the collapsed toolbar",
         "default": {"kind": "local", "key": "allow-monitor-switch-min-toolbar"},
         "enabledBy": {"kind": "local", "key": "allow-monitor-switch-main-toolbar"},
         "after": "reloadAllWindows"},
        {"type": "bool", "label": "Monitors bar (one button per remote screen)",
         "default": {"kind": "default", "key": "show_monitors_toolbar"}},
        {"type": "bool", "label": "Dock the toolbar on any window edge",
         "default": {"kind": "local", "key": "allow-multi-edge-toolbar-dock"},
         "after": "reloadAllWindows"},
        {"type": "widget", "widget": "settingsLayoutReload"}
      ]
    },
    {
      "id": "stream",
      "label": "Stream",
      "icon": "videocam",
      "items": [
        {"type": "radio", "label": "Image quality",
         "options": [
           {"value": "best", "label": "Best image (higher bitrate)"},
           {"value": "balanced", "label": "Balanced"},
           {"value": "low", "label": "Lowest latency (lower bitrate)"},
           {"value": "custom", "label": "Custom bitrate and frame rate"}
         ],
         "default": {"kind": "default", "key": "image_quality"},
         "peer": {"kind": "peer", "key": "image_quality", "live": "imageQuality"}},
        {"type": "radio", "label": "Scale of the remote screen",
         "tooltip": "scale-levels-tip",
         "options": [
           {"value": "adaptive", "label": "Fit to window"},
           {"value": "original", "label": "Original size (100%)"},
           {"value": "custom", "label": "Custom percent"}
         ],
         "default": {"kind": "default", "key": "view_style"},
         "peer": {"kind": "peer", "key": "view_style", "live": "viewStyle"},
         "screen": {"field": "viewStyle"}},
        {"type": "number", "label": "Custom scale percent",
         "screen": {"field": "customScalePercent"}},
        {"type": "widget", "widget": "session.customScale"},
        {"type": "radio", "label": "Video codec",
         "tooltip": "codec-tip",
         "options": "let l = [[\"auto\", \"Auto\"], [\"av1\", \"AV1\"], [\"vp9\", \"VP9\"], [\"vp8\", \"VP8\"]]; let h = hw_decodings(); if h.h264 { l.push([\"h264\", \"H264\", \"codec-hw-tip\"]); } if h.h265 { l.push([\"h265\", \"H265\", \"codec-hw-tip\"]); } l",
         "default": {"kind": "default", "key": "codec-preference"},
         "peer": {"kind": "peer", "key": "codec-preference", "live": "codec"}},
        {"type": "bool", "label": "True color: 4:4:4 chroma (full color resolution)",
         "tooltip": "i444-tip",
         "default": {"kind": "default", "key": "i444"},
         "peer": {"kind": "peer", "key": "i444", "toggle": "i444"}},
        {"type": "bool", "label": "Adaptive bitrate when this PC is controlled (quality follows the measured bandwidth)",
         "condition": "!is_outgoing_only()",
         "default": {"kind": "server", "key": "enable-abr"}},
        {"type": "bool", "label": "Show the quality monitor (frame rate, bitrate, delay, codec)",
         "default": {"kind": "default", "key": "show_quality_monitor"},
         "peer": {"kind": "peer", "key": "show_quality_monitor", "toggle": "show-quality-monitor"}},

        {"type": "section", "label": "Remote cursor"},
        {"type": "bool", "label": "Draw the remote cursor in the picture",
         "tooltip": "show-remote-cursor-tip",
         "default": {"kind": "default", "key": "show_remote_cursor"},
         "peer": {"kind": "peer", "key": "show_remote_cursor", "toggle": "show-remote-cursor"}},
        {"type": "bool", "label": "Switch to the remote screen the remote cursor moves to",
         "default": {"kind": "default", "key": "follow_remote_cursor"},
         "peer": {"kind": "peer", "key": "follow_remote_cursor", "toggle": "follow-remote-cursor"}},
        {"type": "bool", "label": "Switch to the remote screen of the focused remote window",
         "default": {"kind": "default", "key": "follow_remote_window"},
         "peer": {"kind": "peer", "key": "follow_remote_window", "toggle": "follow-remote-window"}},
        {"type": "bool", "label": "Scale the cursor with the picture",
         "default": {"kind": "default", "key": "zoom-cursor"},
         "peer": {"kind": "peer", "key": "zoom-cursor", "toggle": "zoom-cursor"}},

        {"type": "section", "label": "GPU video path", "tooltip": "gpu-path-tip"},
        {"type": "bool", "label": "Hardware video codec (GPU encode and decode of H.264 / H.265)",
         "tooltip": "hwcodec-tip",
         "condition": "has_hwcodec() || has_vram()",
         "default": {"kind": "server", "key": "enable-hwcodec"},
         "after": "checkHwcodec"},
        {"type": "bool", "label": "Capture this PC's screen through DirectX (Desktop Duplication) when controlled",
         "tooltip": "directx-capture-tip",
         "platforms": ["windows"],
         "condition": "!is_outgoing_only()",
         "default": {"kind": "server", "key": "enable-directx-capture"}},
        {"type": "bool", "label": "Decode and present received video with Direct3D 11 (D3D rendering)",
         "tooltip": "d3d_render_tip",
         "platforms": ["windows"],
         "condition": "!is_incoming_only()",
         "default": {"kind": "local", "key": "allow-d3d-render"}},
        {"type": "widget", "widget": "textureRender"},
        {"type": "bool", "label": "Always render in software (no OpenGL)",
         "tooltip": "software_render_tip",
         "platforms": ["linux"],
         "condition": "!is_incoming_only()",
         "default": {"kind": "server", "key": "allow-always-software-render"}},

        {"type": "section", "label": "Recording"},
        {"type": "widget", "widget": "record"}
      ]
    },
    {
      "id": "network",
      "label": "Network",
      "icon": "link",
      "condition": "!is_disable_settings() && builtin_option(\"hide-network-settings\") != \"Y\"",
      "items": [{"type": "page", "page": "network"}]
    },
    {
      "id": "audio",
      "label": "Audio",
      "icon": "volume_up",
      "items": [
        {"type": "radio", "label": "Start sessions muted",
         "tooltip": "start-muted-tip",
         "options": [
           {"value": "", "label": "Use the default"},
           {"value": "Y", "label": "Muted"},
           {"value": "N", "label": "Sound on"}
         ],
         "default": {"kind": "default", "key": "disable_audio", "options": [["Y", "Muted"], ["N", "Sound on"]]},
         "peer": {"kind": "peer", "key": "audio-mute-saved", "live": "peerOption"}},
        {"type": "radio", "label": "Sound this PC sends when it is controlled (capture device)",
         "tooltip": "capture-device-tip",
         "platforms": ["windows", "macos", "linux"],
         "default": {"kind": "server", "key": "audio-input", "options": "let d = audio_inputs(); let l = [[\"\", if audio_loopback() { \"System Sound\" } else { \"Default input device\" }]] + d; if value != \"\" && !d.contains(value) { l.push(value); } l"},
         "peer": {"kind": "peer", "key": "audio-input-device", "options": "let l = [[\"\", \"The remote PC's own setting\"], [\"=\", \"System Sound\"]]; if value.len() > 1 && value.starts_with(\"=\") { l.push([value, value.sub_string(1)]); } l"},
         "session": "session.audioDevices"},
        {"type": "widget", "widget": "session.audioDevices", "label": "Devices, volumes and microphone of this session"}
      ]
    },
    {
      "id": "input",
      "label": "Input",
      "icon": "keyboard",
      "condition": "!is_incoming_only()",
      "items": [
        {"type": "radio", "label": "Keyboard mode",
         "tooltip": "keyboard-mode-tip",
         "options": [
           {"value": "map", "label": "Map mode"},
           {"value": "translate", "label": "Translate mode"},
           {"value": "legacy", "label": "Legacy mode"}
         ],
         "peer": {"kind": "peer", "key": "keyboard_mode", "live": "keyboardMode"}},
        {"type": "radio", "label": "Keyboard capture on this PC",
         "tooltip": "input-source-tip",
         "condition": "input_sources().len() > 1",
         "options": [
           {"value": "Input source 1", "label": "input_source_1_tip"},
           {"value": "Input source 2", "label": "input_source_2_tip"}
         ],
         "default": {"kind": "local", "key": "input-source", "live": "inputSource"}},
        {"type": "widget", "widget": "keyboardShortcuts"},
        {"type": "widget", "widget": "session.keyboardExclude"},
        {"type": "bool", "label": "View Mode",
         "default": {"kind": "default", "key": "view_only"},
         "peer": {"kind": "peer", "key": "view_only", "toggle": "view-only"}},
        {"type": "bool", "label": "Show my cursor",
         "tooltip": "show-my-cursor-tip",
         "peer": {"kind": "peer", "key": "show_my_cursor", "toggle": "show-my-cursor"}},
        {"type": "widget", "widget": "session.relativeMouse"},
        {"type": "bool", "label": "Swap left-right mouse button",
         "default": {"kind": "default", "key": "swap-left-right-mouse"},
         "peer": {"kind": "peer", "key": "swap-left-right-mouse", "toggle": "swap-left-right-mouse"}},
        {"type": "bool", "label": "Reverse mouse wheel",
         "default": {"kind": "default", "key": "reverse_mouse_wheel"},
         "peer": {"kind": "peer", "key": "reverse_mouse_wheel", "live": "reverseWheel"}},
        {"type": "number", "label": "Trackpad speed (%)",
         "default": {"kind": "default", "key": "trackpad-speed"},
         "peer": {"kind": "peer", "key": "trackpad-speed"}},
        {"type": "bool", "label": "Swap control-command key",
         "tooltip": "swap-key-tip",
         "peer": {"kind": "peer", "key": "allow_swap_key", "toggle": "allow_swap_key"}},
        {"type": "widget", "widget": "session.localKeyboardType"},
        {"type": "widget", "widget": "session.mobileActions"}
      ]
    },
    {
      "id": "guest",
      "label": "Guest RustDesk and OS",
      "icon": "desktop_windows",
      "items": [
        {"type": "widget", "widget": "session.resolution"},
        {"type": "widget", "widget": "session.virtualDisplay"},
        {"type": "widget", "widget": "session.adjustWindow"},
        {"type": "widget", "widget": "session.privacyMode"},
        {"type": "bool", "label": "Lock after session end",
         "default": {"kind": "default", "key": "lock_after_session_end"},
         "peer": {"kind": "peer", "key": "lock_after_session_end", "toggle": "lock-after-session-end"}},
        {"type": "section", "label": "This PC when it is controlled"},
        {"type": "widget", "widget": "wallpaper"},
        {"type": "bool", "label": "keep-awake-during-incoming-sessions-label",
         "condition": "!is_outgoing_only()",
         "default": {"kind": "server", "key": "keep-awake-during-incoming-sessions"}},
        {"type": "widget", "widget": "privacyModeImpl", "label": "Privacy mode implementation"},
        {"type": "bool", "label": "Keep terminal sessions on disconnect",
         "default": {"kind": "default", "key": "terminal-persistent"},
         "peer": {"kind": "peer", "key": "terminal-persistent"}}
      ]
    },
    {
      "id": "host",
      "label": "Host RustDesk and OS",
      "icon": "computer",
      "items": [
        {"type": "bool", "label": "keep-awake-during-outgoing-sessions-label",
         "condition": "!is_incoming_only()",
         "default": {"kind": "local", "key": "keep-awake-during-outgoing-sessions"}},
        {"type": "widget", "widget": "noteAtEnd"},
        {"type": "bool", "label": "Show the fallback cursor while the remote PC reports none",
         "tooltip": "fallback-cursor-tip",
         "default": {"kind": "local", "key": "allow-fallback-cursor"}},
        {"type": "section", "label": "Updates"},
        {"type": "bool", "label": "Check for software update on startup",
         "condition": "!is_custom_client()",
         "default": {"kind": "local", "key": "enable-check-update"}},
        {"type": "bool", "label": "Auto update",
         "condition": "(platform == \"windows\" && is_installed()) || (platform == \"macos\" && is_installed() && is_installed_daemon() && !is_custom_client())",
         "default": {"kind": "server", "key": "allow-auto-update"}},
        {"type": "section", "label": "Service"},
        {"type": "widget", "widget": "service"},
        {"type": "widget", "widget": "wayland"}
      ]
    },
    {
      "id": "hostGuest",
      "label": "Host⇄Guest RustDesk and OS",
      "icon": "swap_horiz",
      "items": [
        {"type": "bool", "label": "Share the clipboard with the remote PC",
         "default": {"kind": "default", "key": "disable_clipboard", "invert": true},
         "peer": {"kind": "peer", "key": "disable_clipboard", "toggle": "disable-clipboard", "invert": true}},
        {"type": "bool", "label": "Copy and paste files through the clipboard",
         "default": {"kind": "default", "key": "enable-file-copy-paste"},
         "peer": {"kind": "peer", "key": "enable-file-copy-paste", "toggle": "enable-file-copy-paste"}},
        {"type": "bool", "label": "Sync clipboard between sessions",
         "tooltip": "sync-clipboard-between-sessions-tip",
         "condition": "!is_incoming_only()",
         "default": {"kind": "local", "key": "allow-sync-clipboard-between-sessions"}},
        {"type": "bool", "label": "Sync clipboard with nested sessions",
         "tooltip": "sync-clipboard-nested-sessions-tip",
         "default": {"kind": "local", "key": "allow-sync-clipboard-nested-sessions"}},
        {"type": "bool", "label": "Allow the terminal of a session to write this PC's clipboard",
         "default": {"kind": "local", "key": "allow-terminal-clipboard-write"}}
      ]
    },
    {
      "id": "security",
      "label": "Security",
      "icon": "security",
      "condition": "!is_outgoing_only() && !is_disable_settings() && builtin_option(\"hide-security-settings\") != \"Y\"",
      "items": [{"type": "page", "page": "security"}]
    },
    {
      "id": "account",
      "label": "Account",
      "icon": "person",
      "condition": "!is_disable_account()",
      "items": [{"type": "page", "page": "account"}]
    },
    {
      "id": "printer",
      "label": "Printer",
      "icon": "print",
      "condition": "platform == \"windows\" && !is_disable_settings() && builtin_option(\"hide-remote-printer-settings\") != \"Y\"",
      "items": [{"type": "page", "page": "printer"}]
    },
    {
      "id": "about",
      "label": "About",
      "icon": "info",
      "items": [{"type": "page", "page": "about"}]
    }
  ]
}
